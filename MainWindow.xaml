<Window x:Class="Amaranth10API.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Amaranth10API.Views"
        Title="아맛다보고서"
        Width="1200"
        Height="780"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Icon="Assets/AppIcon.ico"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ───────── 사이드바 232 ───────── -->
        <Border x:Name="SidePanel"
                Width="232"
                Padding="18,22,14,16"
                ClipToBounds="True"
                Visibility="Collapsed">
            <Grid>
            <!-- 배경 캐릭터: 아주 옅게(0.06) 왼쪽 아래에 크게, 발끝은 창 아래로 잘림. 패딩을 무시하도록 음수 여백 -->
            <Canvas Margin="-18,-22,-14,-16" IsHitTestVisible="False">
                <!-- '/'로 시작하면 실행 중인 exe 기준이 되어 테스트에서 못 찾음 → XAML 기준 상대 경로 -->
                <Image x:Name="SidebarCharacter" Source="Assets/SidebarCharacter.png" Width="356" Height="356"
                       Canvas.Left="4" Canvas.Bottom="-72" Opacity="0.06"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Canvas>
            <DockPanel LastChildFill="False">
                <!-- 홈 (로그인 후 처음 보이는 요약 화면) -->
                <RadioButton x:Name="NavHome" DockPanel.Dock="Top" Margin="0,0,0,14" Style="{StaticResource SideNavRadioStyle}"
                             Tag="{StaticResource IconHome}" Content="홈" Click="Home_Click" />

                <!-- 이동 메뉴 -->
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource SideNavRadioStyle}"
                                 Tag="{StaticResource IconList}" Click="Dashboard_Click" IsChecked="True">
                        <Grid>
                            <TextBlock Text="미작성 목록" VerticalAlignment="Center" />
                            <Border x:Name="DashboardBadge" Style="{StaticResource BadgeStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="DashboardBadgeText" Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavMail" Style="{StaticResource SideNavRadioStyle}"
                                 Tag="{StaticResource IconMail}" Click="EmailList_Click">
                        <Grid>
                            <TextBlock Text="메일" VerticalAlignment="Center" />
                            <Border x:Name="MailBadge" Style="{StaticResource BadgeStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="MailBadgeText" Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavManual" Style="{StaticResource SideNavRadioStyle}"
                                 Tag="{StaticResource IconBook}" Content="사용자 매뉴얼" Click="Manual_Click" />
                </StackPanel>

                <!-- 하단 메뉴 -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource SideMenuButtonStyle}" Tag="{StaticResource IconDownload}"
                            Content="업데이트 확인" Click="CheckUpdate_Click" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource SideNavRadioStyle}"
                                 Tag="{StaticResource IconSettings}" Content="환경설정" Click="Settings_Click" />
                    <Button Style="{StaticResource SideMenuButtonStyle}" Tag="{StaticResource IconLogout}"
                            Content="로그아웃" Click="Logout_Click" />
                    <Button Style="{StaticResource SideMenuButtonStyle}" Tag="{StaticResource IconPower}"
                            Content="종료하기" Click="Exit_Click" />
                    <Grid Margin="12,10,12,0">
                        <TextBlock x:Name="UpdateLink"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentFillBrush}"
                                   TextDecorations="Underline"
                                   Cursor="Hand"
                                   Visibility="Collapsed"
                                   ToolTip="클릭하면 새 버전을 설치합니다"
                                   MouseLeftButtonUp="UpdateLink_MouseLeftButtonUp" />
                        <TextBlock x:Name="VersionText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}" />
                    </Grid>
                </StackPanel>
            </DockPanel>
            </Grid>
        </Border>

        <!-- ───────── 콘텐츠 패널 (흰색, 라운드 16) ───────── -->
        <Border x:Name="ContentPanel"
                Grid.Column="1"
                Margin="0"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0"
                CornerRadius="0">
            <Grid>
                <Frame x:Name="RootFrame"
                       NavigationUIVisibility="Hidden"
                       JournalOwnership="OwnsJournal" />

                <!-- 홈 (요약) -->
                <ContentControl x:Name="HomeHost" Visibility="Collapsed"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

                <ContentControl x:Name="MailHost" Visibility="Collapsed"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

                <!-- 사용자 매뉴얼 (새 창 대신 같은 창에서) -->
                <ContentControl x:Name="ManualHost" Visibility="Collapsed"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

                <!-- 환경설정 (사이드바의 '환경설정'으로 열림, 바꾼 값은 바로 저장) -->
                <Border x:Name="SettingsOverlay"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="16"
                        Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32,40,40">
                        <StackPanel MaxWidth="1040">
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Text="환경설정" />
                            <TextBlock Margin="0,6,0,24" FontSize="14" Foreground="{StaticResource SubBrush}"
                                       Text="바꾼 내용은 바로 저장돼요." />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 왼쪽 열 -->
                                <StackPanel>
                                    <!-- 알림 -->
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,6">
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SubBrush}"
                                                       Text="알림" Margin="0,14,0,4" />
                                            <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                                <StackPanel>
                                                    <CheckBox Content="Windows 알림 기능 활성화"
                                                              IsChecked="{Binding NotificationsEnabled}"
                                                              Style="{StaticResource SwitchStyle}" />
                                                    <TextBlock Margin="0,2,56,0" FontSize="12" Foreground="{StaticResource MutedInkBrush}"
                                                               TextWrapping="Wrap" Text="미작성 보고서가 있으면 Windows 알림을 보냅니다." />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel IsEnabled="{Binding NotificationOptionsEnabled}">
                                                <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource InkBrush}"
                                                                   Text="알림 새로고침 간격" />
                                                        <TextBox x:Name="NotificationIntervalBox"
                                                                 Grid.Column="1"
                                                                 Width="72"
                                                                 Style="{StaticResource FieldStyle}"
                                                                 Height="36" MinHeight="36" Padding="8,0"
                                                                 HorizontalContentAlignment="Center"
                                                                 Text="{Binding NotificationIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                                 PreviewTextInput="DigitsOnly"
                                                                 DataObject.Pasting="DigitsOnlyPasting"
                                                                 LostFocus="NotificationInterval_LostFocus" />
                                                        <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="초" />
                                                    </Grid>
                                                </Border>
                                                <Border Padding="0,14">
                                                    <CheckBox Content="알림이 오면 GUI 화면 띄우기"
                                                              IsChecked="{Binding ShowGuiOnNotification}"
                                                              Style="{StaticResource SwitchStyle}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 시작 -->
                                    <Border Margin="0,16,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,6">
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SubBrush}"
                                                       Text="시작" Margin="0,14,0,4" />
                                            <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                                <CheckBox Content="Windows 시작 시 자동 실행"
                                                          IsChecked="{Binding RunOnWindowsStartup}"
                                                          Style="{StaticResource SwitchStyle}" />
                                            </Border>
                                            <Border Padding="0,14">
                                                <CheckBox Content="Windows 시작 시 트레이 아이콘으로 시작"
                                                          IsChecked="{Binding StartInTray}"
                                                          Style="{StaticResource SwitchStyle}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 오른쪽 열 -->
                                <StackPanel Grid.Column="2">
                                    <!-- 세션 -->
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,6">
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SubBrush}"
                                                       Text="세션" Margin="0,14,0,4" />
                                            <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                                <CheckBox Content="네트워크 재연결 시 세션 유지"
                                                          IsChecked="{Binding KeepSessionOnReconnect}"
                                                          Style="{StaticResource SwitchStyle}" />
                                            </Border>
                                            <Border Padding="0,14">
                                                <StackPanel>
                                                    <CheckBox Content="자동 로그인"
                                                              IsChecked="{Binding AutoLoginEnabled}"
                                                              Style="{StaticResource SwitchStyle}" />
                                                    <TextBlock Margin="0,2,56,0" FontSize="12" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap"
                                                               Text="Windows DPAPI로 현재 Windows 계정만 복호화할 수 있게 암호화해 저장합니다. 끄면 저장한 로그인을 지우고 다음부터 직접 로그인합니다." />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- 조회 범위 -->
                                    <Border Margin="0,16,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,6">
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SubBrush}"
                                                       Text="신청서·보고서 조회 범위" Margin="0,14,0,4" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,4" TextWrapping="Wrap"
                                                       Text="현재 달 기준으로 이전/이후 몇 달을 조회할지 정합니다." />
                                            <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="14" Text="신청서" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="이전" Margin="0,0,8,0" />
                                                    <TextBox Grid.Column="2" Style="{StaticResource FieldStyle}" Height="36" MinHeight="36" Padding="6,0"
                                                             HorizontalContentAlignment="Center"
                                                             Text="{Binding ApplicationMonthsBefore, UpdateSourceTrigger=PropertyChanged}"
                                                             PreviewTextInput="DigitsOnly" DataObject.Pasting="DigitsOnlyPasting" />
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="달 ~ 이후" Margin="8,0" />
                                                    <TextBox Grid.Column="4" Style="{StaticResource FieldStyle}" Height="36" MinHeight="36" Padding="6,0"
                                                             HorizontalContentAlignment="Center"
                                                             Text="{Binding ApplicationMonthsAfter, UpdateSourceTrigger=PropertyChanged}"
                                                             PreviewTextInput="DigitsOnly" DataObject.Pasting="DigitsOnlyPasting" />
                                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="달" Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <Border Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="14" Text="보고서" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="이전" Margin="0,0,8,0" />
                                                    <TextBox Grid.Column="2" Style="{StaticResource FieldStyle}" Height="36" MinHeight="36" Padding="6,0"
                                                             HorizontalContentAlignment="Center"
                                                             Text="{Binding ReportMonthsBefore, UpdateSourceTrigger=PropertyChanged}"
                                                             PreviewTextInput="DigitsOnly" DataObject.Pasting="DigitsOnlyPasting" />
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="달 ~ 이후" Margin="8,0" />
                                                    <TextBox Grid.Column="4" Style="{StaticResource FieldStyle}" Height="36" MinHeight="36" Padding="6,0"
                                                             HorizontalContentAlignment="Center"
                                                             Text="{Binding ReportMonthsAfter, UpdateSourceTrigger=PropertyChanged}"
                                                             PreviewTextInput="DigitsOnly" DataObject.Pasting="DigitsOnlyPasting" />
                                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="달" Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="ConfirmOverlay"
                Grid.ColumnSpan="2"
                Background="#661C1B19"
                Visibility="Collapsed"
                Panel.ZIndex="1000"
                Focusable="True"
                MouseLeftButtonDown="ConfirmOverlay_MouseLeftButtonDown">
            <views:ConfirmDialog x:Name="ConfirmDialogHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
