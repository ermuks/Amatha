<Window x:Class="Amaranth10API.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Amaranth10API.Views"
        Title="아맛다보고서"
        Width="900"
        Height="760"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F3F5F8"
        Icon="Assets/AppIcon.ico"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidePanel"
                Width="40"
                Background="#3E5270"
                Visibility="Collapsed">
            <Grid>
                <Button x:Name="HamburgerButton"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="Hamburger_Click"
                        Cursor="Hand"
                        ToolTip="메뉴">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <TextBlock Text="☰"
                                           FontSize="18"
                                           Foreground="#F4F7FA"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#526887" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33455C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Grid x:Name="SideMenuItems" Visibility="Collapsed">
                    <StackPanel Margin="10,56,10,12" VerticalAlignment="Top">
                        <Button Style="{StaticResource SideMenuButtonStyle}"
                                Content="사용자 매뉴얼"
                                Click="Manual_Click" />
                    </StackPanel>
                    <StackPanel Margin="10,56,10,12" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource SideMenuButtonStyle}"
                                Content="환경설정"
                                Click="Settings_Click" />
                        <Button Style="{StaticResource SideMenuButtonStyle}"
                                Content="로그아웃"
                                Click="Logout_Click" />
                        <Button Style="{StaticResource SideMenuButtonStyle}"
                                Content="종료하기"
                                Click="Exit_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Frame x:Name="RootFrame"
                   NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal" />

            <Border x:Name="SettingsOverlay"
                    Background="#F3F5F8"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <Grid Margin="0,0,0,22">
                            <TextBlock FontSize="22" FontWeight="SemiBold"
                                       Foreground="#2A3548" Text="환경설정" />
                            <Button HorizontalAlignment="Right"
                                    Content="닫기"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Click="CloseSettings_Click" />
                        </Grid>

                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#5A6F8A"
                                   Text="알림" Margin="0,0,0,10" />

                        <CheckBox Content="Windows 알림 기능 활성화"
                                  IsChecked="{Binding NotificationsEnabled}"
                                  Style="{StaticResource ToggleCheckStyle}"
                                  Margin="0,0,0,14" />

                        <StackPanel IsEnabled="{Binding NotificationOptionsEnabled}" Margin="18,0,0,24">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#2A3548"
                                           Text="알림 새로고침 간격 (초)" />
                                <TextBox x:Name="NotificationIntervalBox"
                                         Grid.Column="1"
                                         Style="{StaticResource FieldStyle}"
                                         Height="36" MinHeight="36"
                                         Text="{Binding NotificationIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="DigitsOnly"
                                         DataObject.Pasting="DigitsOnlyPasting"
                                         LostFocus="NotificationInterval_LostFocus" />
                            </Grid>
                            <CheckBox Content="GUI 화면 띄우기"
                                      IsChecked="{Binding ShowGuiOnNotification}"
                                      Style="{StaticResource ToggleCheckStyle}" />
                        </StackPanel>

                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#5A6F8A"
                                   Text="세션" Margin="0,0,0,10" />
                        <CheckBox Content="네트워크 재연결 시 세션 유지"
                                  IsChecked="{Binding KeepSessionOnReconnect}"
                                  Style="{StaticResource ToggleCheckStyle}"
                                  Margin="0,0,0,14" />
                        <CheckBox Content="자동 로그인"
                                  IsChecked="{Binding AutoLoginEnabled}"
                                  Style="{StaticResource ToggleCheckStyle}"
                                  Margin="0,0,0,8" />
                        <TextBlock FontSize="12" Foreground="#6D7A8C" Margin="0,0,0,24" TextWrapping="Wrap"
                                   Text="Windows DPAPI로 현재 Windows 계정만 복호화할 수 있게 암호화해 저장합니다. 끄면 저장한 로그인을 지우고 다음부터 직접 로그인합니다." />

                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#5A6F8A"
                                   Text="시작" Margin="0,0,0,10" />
                        <CheckBox Content="Windows 시작 시 자동 실행"
                                  IsChecked="{Binding RunOnWindowsStartup}"
                                  Style="{StaticResource ToggleCheckStyle}"
                                  Margin="0,0,0,14" />
                        <CheckBox Content="Windows 시작 시 트레이 아이콘으로 시작"
                                  IsChecked="{Binding StartInTray}"
                                  Style="{StaticResource ToggleCheckStyle}"
                                  Margin="0,0,0,24" />

                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#5A6F8A"
                                   Text="신청서/보고서 조회 범위" Margin="0,0,0,10" />
                        <TextBlock FontSize="12" Foreground="#6D7A8C" Margin="0,0,0,12"
                                   Text="현재 달 기준으로 이전/이후 몇 달을 조회할지 정합니다." />

                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#2A3548"
                                   Text="신청서" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="이전" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Style="{StaticResource FieldStyle}" Height="36" MinHeight="36"
                                     Text="{Binding ApplicationMonthsBefore, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="DigitsOnly" DataObject.Pasting="DigitsOnlyPasting" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="달  ~  이후" Margin="10,0,8,0" />
                            <TextBox Grid.Column="3" Style="{StaticResource FieldStyle}" Height="36" MinHeight="36"
                                     Text="{Binding ApplicationMonthsAfter, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="DigitsOnly" DataObject.Pasting="DigitsOnlyPasting" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="달" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#2A3548"
                                   Text="보고서" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="이전" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Style="{StaticResource FieldStyle}" Height="36" MinHeight="36"
                                     Text="{Binding ReportMonthsBefore, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="DigitsOnly" DataObject.Pasting="DigitsOnlyPasting" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="달  ~  이후" Margin="10,0,8,0" />
                            <TextBox Grid.Column="3" Style="{StaticResource FieldStyle}" Height="36" MinHeight="36"
                                     Text="{Binding ReportMonthsAfter, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="DigitsOnly" DataObject.Pasting="DigitsOnlyPasting" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="달" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="{StaticResource MistBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,7">
            <Grid>
                <TextBlock x:Name="UpdateLink"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource NavyBrush}"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           Visibility="Collapsed"
                           ToolTip="클릭하면 새 버전을 설치합니다"
                           MouseLeftButtonUp="UpdateLink_MouseLeftButtonUp" />
                <TextBlock x:Name="VersionText"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="{StaticResource MutedInkBrush}" />
            </Grid>
        </Border>

        <Border x:Name="ConfirmOverlay"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Background="#66000000"
                Visibility="Collapsed"
                Panel.ZIndex="1000"
                Focusable="True"
                MouseLeftButtonDown="ConfirmOverlay_MouseLeftButtonDown">
            <views:ConfirmDialog x:Name="ConfirmDialogHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
