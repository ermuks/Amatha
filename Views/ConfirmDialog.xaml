<UserControl x:Class="Amaranth10API.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="DialogQuietStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="DialogPrimaryStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A3AB5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="DialogCard" Width="420"
            MaxWidth="600"
            Padding="28,26,28,22"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FFFFFF"
            BorderBrush="#E6E4DE"
            BorderThickness="1"
            CornerRadius="16"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40"
                              ShadowDepth="12"
                              Direction="270"
                              Opacity="0.18"
                              Color="#1C1B19" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#5F5D57"
                       Text="종료하기" />
            <TextBlock x:Name="MessageText"
                       Margin="0,8,0,0"
                       FontSize="18"
                       FontWeight="SemiBold"
                       LineHeight="26"
                       Foreground="#1C1B19"
                       TextWrapping="Wrap"
                       Text="정말로 종료하시겠습니까?" />
            <TextBlock x:Name="DetailText"
                       Margin="0,10,0,0"
                       FontSize="13"
                       LineHeight="20"
                       Foreground="#6E6B64"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="SilentUpdateCheckBox" Content="조용히 업데이트하기"
                          Style="{StaticResource BoxCheckStyle}"
                          FontSize="13" Foreground="#4A4843"
                          VerticalAlignment="Center" HorizontalAlignment="Left"
                          Margin="0,0,16,0" Visibility="Collapsed"
                          ToolTip="현재 설치 경로에 업데이트하고 트레이로 다시 실행합니다." />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource DialogQuietStyle}"
                            Content="아니오"
                            IsCancel="True"
                            Click="No_Click" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource DialogPrimaryStyle}"
                            Content="예"
                            IsDefault="True"
                            Click="Yes_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
