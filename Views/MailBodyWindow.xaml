<Window x:Class="Amaranth10API.Views.MailBodyWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="메일 본문" Width="980" Height="780" MinWidth="640" MinHeight="420"
 WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock x:Name="SubjectText" FontSize="20" FontWeight="SemiBold" Foreground="#3E5270" TextWrapping="Wrap"/>
   <TextBlock x:Name="FromText" Margin="0,8,0,0" TextWrapping="Wrap"/>
   <TextBlock x:Name="ToText" Margin="0,4,0,0" TextWrapping="Wrap"/>
   <TextBlock x:Name="DateText" Margin="0,4,0,0" Foreground="#5A6F8A"/>
   <TextBlock x:Name="AttachmentText" Margin="0,4,0,0" Foreground="#5A6F8A" Visibility="Collapsed"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="ImagesButton" Style="{StaticResource QuietButtonStyle}" Content="이미지 표시" Margin="8,0" Click="Images_Click" IsEnabled="False"/>
    <Button x:Name="RetryButton" Style="{StaticResource QuietButtonStyle}" Content="다시 불러오기" Click="Retry_Click"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Text="본문을 불러오는 중입니다…" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#5A6F8A"/>
  </DockPanel>
  <Grid x:Name="BrowserHost" Grid.Row="2" Background="White"/>
 </Grid>
</Window>
