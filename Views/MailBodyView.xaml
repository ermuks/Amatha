<UserControl x:Class="Amaranth10API.Views.MailBodyView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#FFFFFF" Foreground="#1C1B19">
 <!-- MailView 와 같은 이유로 QuietButtonStyle 외의 앱 리소스를 참조하지 않습니다. -->
 <UserControl.Resources>
  <!-- 첨부파일 카드: 확장자 배지 색은 ExtensionKind(pdf·sheet·doc·other)로 정함 -->
  <DataTemplate x:Key="AttachmentTemplate">
   <Border Margin="0,0,0,8" Padding="12,10,10,10" Background="#FFFFFF" BorderBrush="#E6E4DE" BorderThickness="1" CornerRadius="12">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border x:Name="Ext" Width="40" Height="40" CornerRadius="10" Background="#EDEDEA">
      <TextBlock x:Name="ExtText" Text="{Binding Extension}" FontSize="10" FontWeight="Bold" Foreground="#4A4843"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
      <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
      <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="#6E6B64" Margin="0,2,0,0" ToolTip="메일 서버에서 제공한 용량으로, 저장 파일의 크기와 다를 수 있습니다."/>
     </StackPanel>
     <Button Grid.Column="2" Content="다운로드" Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Center"
             IsEnabled="{Binding CanDownload}" Click="Download_Click" ToolTip="저장 위치를 선택해 다운로드"/>
    </Grid>
   </Border>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding ExtensionKind}" Value="pdf">
     <Setter TargetName="Ext" Property="Background" Value="#FDECEC"/>
     <Setter TargetName="ExtText" Property="Foreground" Value="#B42318"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ExtensionKind}" Value="sheet">
     <Setter TargetName="Ext" Property="Background" Value="#E7F5EC"/>
     <Setter TargetName="ExtText" Property="Foreground" Value="#17663A"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ExtensionKind}" Value="doc">
     <Setter TargetName="Ext" Property="Background" Value="#E8F0FE"/>
     <Setter TargetName="ExtText" Property="Foreground" Value="#1E4FB8"/>
    </DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
 </UserControl.Resources>

 <Grid Margin="28,24,28,0">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- 제목 + 본문 닫기 (2단 화면이라 목록은 왼쪽에 계속 보임) -->
  <DockPanel>
   <Button x:Name="BackButton" DockPanel.Dock="Right" Content="닫기" VerticalAlignment="Top" Margin="16,0,0,0"
           Style="{StaticResource QuietButtonStyle}" Click="Back_Click" ToolTip="본문 닫기 (진행 중인 다운로드는 취소됩니다)"/>
   <TextBlock x:Name="SubjectText" FontSize="20" FontWeight="Bold" Foreground="#1C1B19" TextWrapping="Wrap" LineHeight="28" VerticalAlignment="Center"/>
  </DockPanel>

  <!-- 보낸 사람 -->
  <StackPanel Grid.Row="1">
   <Border Margin="0,14,0,0" Padding="0,0,0,14" BorderBrush="#EFEDE8" BorderThickness="0,0,0,1">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="38" Height="38" CornerRadius="19" Background="#EEECFA" VerticalAlignment="Center">
      <TextBlock x:Name="AvatarText" FontSize="14" FontWeight="Bold" Foreground="#5847C9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
      <TextBlock x:Name="FromText" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <TextBlock x:Name="ToText" Margin="0,2,0,0" FontSize="12" Foreground="#6E6B64" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
     </StackPanel>
     <TextBlock x:Name="DateText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#6E6B64"/>
    </Grid>
   </Border>
  </StackPanel>

  <!-- 불러오기 상태 (문구가 있을 때만 보임) -->
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <DockPanel.Style>
    <Style TargetType="DockPanel">
     <Style.Triggers>
      <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </DockPanel.Style>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="RetryButton" Style="{StaticResource QuietButtonStyle}" Content="다시 불러오기" Click="Retry_Click"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Text="본문을 불러오는 중입니다…" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="#5F5D57"/>
  </DockPanel>

  <!-- 본문 (WebView2) -->
  <Grid x:Name="BrowserHost" Grid.Row="3" Margin="0,12,0,0" Background="White"/>

  <!-- 첨부파일 (있을 때만) -->
  <Border Grid.Row="4" BorderBrush="#EFEDE8" BorderThickness="0,1,0,0" Padding="0,14,0,16"
          Visibility="{Binding Visibility, ElementName=AttachmentPanel}">
   <StackPanel>
    <DockPanel>
     <Button x:Name="DownloadAllButton" DockPanel.Dock="Right" Content="모두 다운로드" Style="{StaticResource QuietButtonStyle}" Visibility="Collapsed" Click="DownloadAll_Click" ToolTip="폴더를 선택해 모든 첨부파일 저장"/>
     <TextBlock x:Name="AttachmentText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#4A4843" Visibility="Collapsed"/>
    </DockPanel>
    <ScrollViewer x:Name="AttachmentPanel" Margin="0,12,0,0" MaxHeight="172" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
     <!-- 오른쪽 본문 칸이 좁을 수 있어 첨부 카드는 한 줄에 하나씩 -->
     <ItemsControl x:Name="AttachmentList" Margin="0,0,0,-8" ItemTemplate="{StaticResource AttachmentTemplate}"/>
    </ScrollViewer>
    <DockPanel Margin="0,8,0,0">
     <Button x:Name="CancelDownloadButton" DockPanel.Dock="Right" Content="다운로드 취소" Style="{StaticResource QuietButtonStyle}" Visibility="Collapsed" Click="CancelDownload_Click"/>
     <TextBlock x:Name="DownloadStatusText" VerticalAlignment="Center" FontSize="12" Foreground="#6E6B64" TextWrapping="Wrap"/>
    </DockPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
