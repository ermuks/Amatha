<Page x:Class="Amaranth10API.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="로그인"
      Background="{StaticResource BgBrush}">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="420" Padding="40"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <!-- 로고 -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <Border.Background>
                                <ImageBrush ImageSource="../Assets/Logo.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}" Text="아맛다보고서" />
                    </StackPanel>

                    <TextBlock Margin="0,28,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                               Text="다시 만나서 반가워요" />
                    <!-- 카드 안쪽 폭(340)에서 한 글자만 다음 줄로 넘어가지 않도록 끊는 위치를 정해 둠 -->
                    <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" LineHeight="21"
                               Text="작성하지 않은 출장·휴일근무 보고서를&#10;바로 확인할 수 있어요." />

                    <TextBlock Margin="0,28,0,8" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink3Brush}" Text="아이디" />
                    <TextBox x:Name="IdBox"
                             Style="{StaticResource FieldStyle}"
                             IsEnabled="{Binding CanEditLogin}"
                             Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="Input_KeyDown" />

                    <TextBlock Margin="0,16,0,8" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink3Brush}" Text="비밀번호" />
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource PasswordFieldStyle}"
                                 IsEnabled="{Binding CanEditLogin}"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 KeyDown="Input_KeyDown" />

                    <TextBlock Margin="0,14,0,0" FontSize="13" Foreground="{StaticResource RedBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding HasError, Converter={StaticResource VisibleIfTrue}}" />

                    <Button Margin="0,24,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{Binding LoginButtonText}"
                            IsEnabled="{Binding CanEditLogin}"
                            Click="LoginButton_Click" />

                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource MutedInkBrush}"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource VisibleIfTrue}}" />

                    <Button Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource QuietButtonStyle}"
                            Content="연결 대기 취소"
                            Visibility="{Binding IsWaitingForNetwork, Converter={StaticResource VisibleIfTrue}}"
                            Click="CancelWait_Click" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="LoginVersionText" Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource MutedInkBrush}" />
        </StackPanel>
    </Grid>
</Page>
