<Window x:Class="Amaranth10API.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="아맛다보고서"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <!-- Tag = 아이콘 Geometry -->
        <Style x:Key="TrayMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1C1B19" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                    <Path Style="{StaticResource IconPath}"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}" />
                                </Viewbox>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F0EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="#FFFFFF"
            BorderBrush="#E6E4DE"
            BorderThickness="1"
            CornerRadius="12"
            Width="196">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="6"
                              Direction="270"
                              Opacity="0.16"
                              Color="#1C1B19" />
        </Border.Effect>
        <StackPanel Margin="6">
            <Button Style="{StaticResource TrayMenuItemStyle}"
                    Tag="{StaticResource IconEye}"
                    Content="GUI 보이기"
                    Click="ShowGui_Click" />
            <Button Style="{StaticResource TrayMenuItemStyle}"
                    Tag="{StaticResource IconPower}"
                    Foreground="#B42318"
                    Content="종료하기"
                    Click="Exit_Click" />
        </StackPanel>
    </Border>
</Window>
