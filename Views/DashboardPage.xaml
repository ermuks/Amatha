<Page x:Class="Amaranth10API.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:Amaranth10API.ViewModels"
      Title="보고서"
      Background="{StaticResource SurfaceBrush}">
    <Page.Resources>
        <!-- 미작성 목록 한 행 (출장·휴일근무·대체휴가 공통) -->
        <DataTemplate x:Key="MissingRowTemplate" DataType="{x:Type vm:MissingPeriodViewModel}">
            <Button Style="{StaticResource CardButtonStyle}" Click="Period_Click">
                <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="20,14,16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 유형 타일 36x36 -->
                        <Border x:Name="Tile" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
                                Background="{StaticResource AccentTileBrush}">
                            <Viewbox Width="18" Height="18">
                                <Path x:Name="TileIcon" Style="{StaticResource IconPath}"
                                      Data="{StaticResource IconBriefcase}" Stroke="{StaticResource AccentFillBrush}" />
                            </Viewbox>
                        </Border>

                        <!-- 이름 + 신청서 제목 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MutedInkBrush}"
                                       TextTrimming="CharacterEllipsis" Text="{Binding Hint}" ToolTip="{Binding Hint}"
                                       Visibility="{Binding HintVisibility}" />
                        </StackPanel>

                        <!-- 기간 + 프로젝트 코드 -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock FontSize="14" Foreground="{StaticResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" Text="{Binding PeriodText}" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MutedInkBrush}"
                                       TextTrimming="CharacterEllipsis" Text="{Binding ProjectCode}"
                                       Visibility="{Binding ProjectCodeVisibility}" />
                        </StackPanel>

                        <!-- 상태 칩 -->
                        <Border x:Name="Chip" Grid.Column="6" Style="{StaticResource ChipStyle}" Background="{StaticResource RedBgBrush}">
                            <TextBlock x:Name="ChipLabel" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource RedBrush}" Text="{Binding ChipText}" />
                        </Border>

                        <!-- 일수 -->
                        <TextBlock Grid.Column="7" MinWidth="40" VerticalAlignment="Center" TextAlignment="Right"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                   Text="{Binding DayCountText}" Visibility="{Binding DayCountVisibility}" />

                        <Viewbox Grid.Column="9" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Path Style="{StaticResource IconPath}" StrokeThickness="2" Data="{StaticResource IconChevronRight}"
                                  Stroke="{StaticResource FaintBrush}" />
                        </Viewbox>

                        <!-- 둘째 줄: 상태 설명 + 알림 끄기 + 삭제 -->
                        <DockPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="8" Margin="0,6,0,0" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource BoxCheckStyle}"
                                          Content="2시간 동안 알리지 않음"
                                          ToolTip="체크한 항목의 알림을 2시간 동안 중지합니다. 체크를 풀거나 2시간이 지나면 다음 알림 주기에 다시 포함됩니다."
                                          IsChecked="{Binding IsNotificationSnoozed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Padding="8,0" Height="32"
                                          Click="NotificationSnooze_Click" />
                                <Button Style="{StaticResource GhostIconButtonStyle}"
                                        Tag="{StaticResource IconTrash}"
                                        Content="삭제"
                                        Margin="4,0,0,0"
                                        ToolTip="이 항목을 목록과 알림에서 영구 제외합니다. ERP 문서는 삭제하지 않습니다."
                                        Click="Dismiss_Click" />
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                                       Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap"
                                       Text="{Binding StatusText}" Visibility="{Binding StatusVisibility}" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding TileKind}" Value="holiday">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource OrangeBgBrush}" />
                    <Setter TargetName="TileIcon" Property="Data" Value="{StaticResource IconCalendar}" />
                    <Setter TargetName="TileIcon" Property="Stroke" Value="{StaticResource OrangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TileKind}" Value="substitute">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource GreenBgBrush}" />
                    <Setter TargetName="TileIcon" Property="Data" Value="{StaticResource IconSun}" />
                    <Setter TargetName="TileIcon" Property="Stroke" Value="{StaticResource GreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TileKind}" Value="error">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource RedBgBrush}" />
                    <Setter TargetName="TileIcon" Property="Data" Value="{StaticResource IconAlert}" />
                    <Setter TargetName="TileIcon" Property="Stroke" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Stage}" Value="ongoing">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource OrangeBgBrush}" />
                    <Setter TargetName="ChipLabel" Property="Foreground" Value="{StaticResource OrangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Stage}" Value="upcoming">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource BlueBgBrush}" />
                    <Setter TargetName="ChipLabel" Property="Foreground" Value="{StaticResource BlueBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 목록 컨테이너 (마지막 행의 구분선은 잘라 냄) -->
        <Style x:Key="ListBoxBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- 행 배경이 둥근 모서리를 덮지 않도록 테두리는 목록 위에 따로 그림 -->
        <Style x:Key="ListFrameStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CountPillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
        </Style>

        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="StatUnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="Margin" Value="4,0,0,5" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Text" Value="건" />
        </Style>

        <!-- 비어 있는 섹션: 점선 상자 -->
        <ControlTemplate x:Key="EmptySectionTemplate" TargetType="ContentControl">
            <Grid>
                <Rectangle RadiusX="12" RadiusY="12" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" StrokeDashArray="4 3" />
                <StackPanel Orientation="Horizontal" Margin="20,16">
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                        <Path Style="{StaticResource IconPath}" StrokeThickness="2.2" Data="{StaticResource IconCheck}" Stroke="{StaticResource GreenBrush}" />
                    </Viewbox>
                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" TextElement.FontSize="13"
                                      TextElement.Foreground="{StaticResource MutedInkBrush}" />
                </StackPanel>
            </Grid>
        </ControlTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer Padding="40,32,40,40"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsBusy, Converter={StaticResource HiddenIfTrue}}">
            <StackPanel MaxWidth="1040">

                <!-- 머리말 -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="13" Foreground="{StaticResource MutedInkBrush}" Text="{Binding TodayText}" />
                        <TextBlock Margin="0,4,0,0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                   TextTrimming="CharacterEllipsis" Text="{Binding GreetingText}" />
                        <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource SubBrush}"
                                   TextWrapping="Wrap" Text="{Binding SubtitleText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}" Text="{Binding LastSyncedText}" />
                        <Button Style="{StaticResource IconTextButtonStyle}" Tag="{StaticResource IconRefresh}"
                                Content="새로고침" IsEnabled="{Binding IsIdle}" Click="Refresh_Click" />
                    </StackPanel>
                </Grid>

                <!-- 배너 -->
                <Border Padding="18,16" CornerRadius="12" Margin="0,0,0,24">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BannerKind}" Value="clear">
                                    <Setter Property="Background" Value="{StaticResource GreenBgBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18">
                                <Path>
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                            <Setter Property="Data" Value="{StaticResource IconBell}" />
                                            <Setter Property="Stroke" Value="{StaticResource AccentFillBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BannerKind}" Value="clear">
                                                    <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                    <Setter Property="Stroke" Value="{StaticResource GreenBrush}" />
                                                    <Setter Property="StrokeThickness" Value="2.2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontSize="14" LineHeight="22" Foreground="{StaticResource Ink2Brush}">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding BannerTitle, Mode=OneWay}" />
                            <Run Text="{Binding BannerMessage, Mode=OneWay}" />
                        </TextBlock>
                        <Button Grid.Column="2" Style="{StaticResource SoftButtonStyle}" Content="알림 설정"
                                VerticalAlignment="Center" Click="OpenSettings_Click" />
                    </Grid>
                </Border>

                <!-- 요약 4칸 -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="20,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="작성 필요" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding OverdueReportCount}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatNumberStyle}">
                                                <Setter Property="Foreground" Value="{StaticResource AccentFillBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OverdueReportCount}" Value="0">
                                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatUnitStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="20,18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="출장 보고서" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource StatNumberStyle}" Text="{Binding MissingTripCount}" />
                                    <TextBlock Style="{StaticResource StatUnitStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="20,18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="휴일근무 보고서" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource StatNumberStyle}" Text="{Binding MissingHolidayCount}" />
                                    <TextBlock Style="{StaticResource StatUnitStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="20,18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="대체휴가 요청서" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource StatNumberStyle}" Text="{Binding SubstituteIssueCount}" />
                                    <TextBlock Style="{StaticResource StatUnitStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 출장 보고서 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="출장 보고서" />
                    <Border Style="{StaticResource CountPillStyle}">
                        <TextBlock Style="{StaticResource CountPillTextStyle}" Text="{Binding TripCountLabel}" />
                    </Border>
                </StackPanel>
                <ContentControl Template="{StaticResource EmptySectionTemplate}" Content="{Binding TripEmptyText}"
                                Visibility="{Binding HasMissingTrips, Converter={StaticResource HiddenIfTrue}}" />
                <Grid Visibility="{Binding HasMissingTrips, Converter={StaticResource VisibleIfTrue}}">
                    <Border Style="{StaticResource ListBoxBorderStyle}">
                        <ItemsControl Margin="0,0,0,-1" ItemsSource="{Binding MissingTrips}" ItemTemplate="{StaticResource MissingRowTemplate}" />
                    </Border>
                    <Border Style="{StaticResource ListFrameStyle}" />
                </Grid>

                <!-- 휴일근무 보고서 -->
                <StackPanel Orientation="Horizontal" Margin="0,28,0,12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="휴일근무 보고서" />
                    <Border Style="{StaticResource CountPillStyle}">
                        <TextBlock Style="{StaticResource CountPillTextStyle}" Text="{Binding HolidayCountLabel}" />
                    </Border>
                </StackPanel>
                <ContentControl Template="{StaticResource EmptySectionTemplate}" Content="{Binding HolidayEmptyText}"
                                Visibility="{Binding HasMissingHolidayWork, Converter={StaticResource HiddenIfTrue}}" />
                <Grid Visibility="{Binding HasMissingHolidayWork, Converter={StaticResource VisibleIfTrue}}">
                    <Border Style="{StaticResource ListBoxBorderStyle}">
                        <ItemsControl Margin="0,0,0,-1" ItemsSource="{Binding MissingHolidayWorks}" ItemTemplate="{StaticResource MissingRowTemplate}" />
                    </Border>
                    <Border Style="{StaticResource ListFrameStyle}" />
                </Grid>

                <!-- 대체휴가 요청서 -->
                <StackPanel Orientation="Horizontal" Margin="0,28,0,12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="대체휴가 요청서" />
                    <Border Style="{StaticResource CountPillStyle}">
                        <TextBlock Style="{StaticResource CountPillTextStyle}" Text="{Binding SubstituteCountLabel}" />
                    </Border>
                </StackPanel>
                <ContentControl Template="{StaticResource EmptySectionTemplate}" Content="{Binding SubstituteEmptyText}"
                                Visibility="{Binding HasSubstituteIssues, Converter={StaticResource HiddenIfTrue}}" />
                <Grid Visibility="{Binding HasSubstituteIssues, Converter={StaticResource VisibleIfTrue}}">
                    <Border Style="{StaticResource ListBoxBorderStyle}">
                        <ItemsControl Margin="0,0,0,-1" ItemsSource="{Binding SubstituteHolidayIssues}" ItemTemplate="{StaticResource MissingRowTemplate}" />
                    </Border>
                    <Border Style="{StaticResource ListFrameStyle}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 오류 -->
        <Border Margin="40,0,40,24" Padding="14,12"
                VerticalAlignment="Bottom" Background="{StaticResource RedBgBrush}"
                BorderBrush="#F5C9C5" BorderThickness="1" CornerRadius="10"
                Visibility="{Binding HasError, Converter={StaticResource VisibleIfTrue}}">
            <TextBlock FontSize="13" Foreground="{StaticResource RedBrush}"
                       TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
        </Border>

        <!-- 불러오는 중 -->
        <Grid Background="#B8FFFFFF"
              Visibility="{Binding IsBusy, Converter={StaticResource VisibleIfTrue}}">
            <Border Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.10" Color="#1C1B19" />
                </Border.Effect>
                <StackPanel>
                    <ProgressBar Width="160" Style="{StaticResource SlimProgressStyle}" IsIndeterminate="True" />
                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource SubBrush}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
