<Application x:Class="Amaranth10API.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Amaranth10API.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--
            v1.14.0 리디자인 디자인 토큰 (docs/redesign/REDESIGN.md 참고)
            웜 그레이 바탕 + 흰색 콘텐츠 패널 + 보라 포인트 컬러 1개
        -->

        <!-- 폰트: Assets/Fonts 의 IBM Plex Sans KR (Resource로 임베드) -->
        <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#IBM Plex Sans KR</FontFamily>

        <!-- 바탕/면 -->
        <SolidColorBrush x:Key="BgBrush" Color="#F1F0EC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#FAFAF8" />
        <SolidColorBrush x:Key="FieldBrush" Color="#F5F4F0" />
        <SolidColorBrush x:Key="HoverBrush" Color="#E8E7E2" />
        <!-- 선 -->
        <SolidColorBrush x:Key="LineSoftBrush" Color="#EFEDE8" />
        <SolidColorBrush x:Key="LineStrongBrush" Color="#E0DED8" />
        <!-- 글자 -->
        <SolidColorBrush x:Key="Ink2Brush" Color="#2E2D2A" />
        <SolidColorBrush x:Key="Ink3Brush" Color="#4A4843" />
        <SolidColorBrush x:Key="SubBrush" Color="#5F5D57" />
        <SolidColorBrush x:Key="FaintBrush" Color="#9A978F" />
        <!-- 포인트 -->
        <SolidColorBrush x:Key="AccentFillBrush" Color="#5847C9" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4A3AB5" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#F2F0FB" />
        <SolidColorBrush x:Key="AccentTileBrush" Color="#EEECFA" />
        <SolidColorBrush x:Key="DarkBrush" Color="#1C1B19" />
        <!-- 상태 -->
        <SolidColorBrush x:Key="BlueBgBrush" Color="#E8F0FE" />
        <SolidColorBrush x:Key="BlueBrush" Color="#1E4FB8" />
        <SolidColorBrush x:Key="OrangeBgBrush" Color="#FFF1E0" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#9A4A00" />
        <SolidColorBrush x:Key="GreenBgBrush" Color="#E7F5EC" />
        <SolidColorBrush x:Key="GreenBrush" Color="#17663A" />
        <SolidColorBrush x:Key="RedBgBrush" Color="#FDECEC" />
        <SolidColorBrush x:Key="RedBrush" Color="#B42318" />
        <SolidColorBrush x:Key="NeutralBgBrush" Color="#EDEDEA" />

        <!-- 기존 키(다른 화면 호환용) — 새 팔레트로 재매핑 -->
        <SolidColorBrush x:Key="NavyBrush" Color="#5847C9" />
        <SolidColorBrush x:Key="NavyMutedBrush" Color="#5F5D57" />
        <SolidColorBrush x:Key="InkBrush" Color="#1C1B19" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="#6E6B64" />
        <SolidColorBrush x:Key="LineBrush" Color="#E6E4DE" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F1F0EC" />
        <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MistBrush" Color="#F1F0EC" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B42318" />
        <SolidColorBrush x:Key="InProgressBrush" Color="#9A4A00" />
        <SolidColorBrush x:Key="InProgressCardBrush" Color="#FFF1E0" />
        <SolidColorBrush x:Key="InProgressLineBrush" Color="#F3D9B8" />

        <helpers:BoolToVisibilityConverter x:Key="VisibleIfTrue" />
        <helpers:BoolToVisibilityConverter x:Key="HiddenIfTrue" Invert="True" />

        <!-- 아이콘 (24x24 그리드, 선 아이콘). IconPath 스타일 + Viewbox 로 크기 지정 -->
        <StreamGeometry x:Key="IconLogo">M14,3 H7 A2,2 0 0 0 5,5 V19 A2,2 0 0 0 7,21 H17 A2,2 0 0 0 19,19 V8 Z M9,14 L11,16 L15,12</StreamGeometry>
        <StreamGeometry x:Key="IconHome">M3,10.5 L12,3 L21,10.5 M5,9.5 V20 H19 V9.5 M10,20 V15 H14 V20</StreamGeometry>
        <StreamGeometry x:Key="IconList">M7,4 H17 A2,2 0 0 1 19,6 V19 A2,2 0 0 1 17,21 H7 A2,2 0 0 1 5,19 V6 A2,2 0 0 1 7,4 Z M9,4 H15 V7 H9 Z M9,12 H15 M9,16 H13</StreamGeometry>
        <StreamGeometry x:Key="IconMail">M5,5 H19 A2,2 0 0 1 21,7 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 V7 A2,2 0 0 1 5,5 Z M3,7 L12,13 L21,7</StreamGeometry>
        <StreamGeometry x:Key="IconBook">M4,5 A2,2 0 0 1 6,3 H19 V19 H6 A2,2 0 0 0 4,21 Z M4,19 V5 M9,7 H15</StreamGeometry>
        <StreamGeometry x:Key="IconDownload">M12,4 V15 M7,10 L12,15 L17,10 M5,20 H19</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z M12,2 V5 M12,19 V22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M2,12 H5 M19,12 H22 M4.9,19.1 L7,17 M17,7 L19.1,4.9</StreamGeometry>
        <StreamGeometry x:Key="IconLogout">M15,4 H18 A2,2 0 0 1 20,6 V18 A2,2 0 0 1 18,20 H15 M10,17 L15,12 L10,7 M15,12 H4</StreamGeometry>
        <StreamGeometry x:Key="IconPower">M12,3 V12 M6.3,6.3 A8,8 0 1 0 17.7,6.3</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M20,11 A8,8 0 1 0 17.7,16.7 M20,5 V11 H14</StreamGeometry>
        <StreamGeometry x:Key="IconBell">M6,16 V11 A6,6 0 0 1 18,11 V16 L19.5,18 H4.5 Z M10,20 A2,2 0 0 0 14,20</StreamGeometry>
        <StreamGeometry x:Key="IconBriefcase">M5,7 H19 A2,2 0 0 1 21,9 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 V9 A2,2 0 0 1 5,7 Z M9,7 V5 A1,1 0 0 1 10,4 H14 A1,1 0 0 1 15,5 V7 M3,13 H21</StreamGeometry>
        <StreamGeometry x:Key="IconCalendar">M5,5 H19 A2,2 0 0 1 21,7 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V7 A2,2 0 0 1 5,5 Z M8,3 V7 M16,3 V7 M3,10 H21</StreamGeometry>
        <StreamGeometry x:Key="IconSun">M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12 Z M12,2 V4 M12,20 V22 M4.9,4.9 L6.3,6.3 M17.7,17.7 L19.1,19.1 M2,12 H4 M20,12 H22 M4.9,19.1 L6.3,17.7 M17.7,6.3 L19.1,4.9</StreamGeometry>
        <StreamGeometry x:Key="IconAlert">M12,3 L2,20 H22 Z M12,10 V14 M12,17 V17.01</StreamGeometry>
        <StreamGeometry x:Key="IconChevronRight">M9,6 L15,12 L9,18</StreamGeometry>
        <StreamGeometry x:Key="IconChevronLeft">M15,6 L9,12 L15,18</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M5,12 L10,17 L19,7</StreamGeometry>
        <StreamGeometry x:Key="IconPaperclip">M21,11 L12.5,19.5 A5,5 0 0 1 5.5,12.5 L14,4 A3.5,3.5 0 0 1 19,9 L10.5,17.5 A2,2 0 0 1 7.5,14.5 L15,7</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M18,11 A7,7 0 1 1 4,11 A7,7 0 1 1 18,11 Z M20,20 L16.5,16.5</StreamGeometry>
        <StreamGeometry x:Key="IconInbox">M3,13 H8 L9,16 H15 L16,13 H21 M5,5 H19 L21,13 V19 H3 V13 Z</StreamGeometry>
        <StreamGeometry x:Key="IconEye">M2,12 C2,12 6,5 12,5 C18,5 22,12 22,12 C22,12 18,19 12,19 C6,19 2,12 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z</StreamGeometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="{x:Null}" />
        </Style>

        <!-- ───────── 사이드 메뉴 ───────── -->
        <!-- Tag 에 아이콘 Geometry 를 넣는다. RadioButton(이동)과 Button(동작) 모두 사용 -->
        <ControlTemplate x:Key="NavTemplate" TargetType="ButtonBase">
            <Grid>
                <Border x:Name="Shadow" CornerRadius="10" Background="#FFFFFF" Opacity="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#1C1B19" />
                    </Border.Effect>
                </Border>
                <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                            <Path x:Name="Icon" Style="{StaticResource IconPath}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" />
                        </Viewbox>
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </Grid>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#E8E7E2" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#E1E0DA" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                    <Setter TargetName="Shadow" Property="Opacity" Value="1" />
                    <Setter TargetName="Icon" Property="Stroke" Value="#5847C9" />
                    <Setter Property="Foreground" Value="#1C1B19" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SideMenuButtonStyle" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4A4843" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource NavTemplate}" />
        </Style>

        <Style x:Key="SideNavRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource SideMenuButtonStyle}">
            <Setter Property="GroupName" Value="SideNav" />
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#5847C9" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ───────── 입력 ───────── -->
        <Style x:Key="ToggleCheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1C1B19" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 설정 화면 토글 스위치 (Content = 왼쪽 라벨, 오른쪽 36x20 스위치) -->
        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1C1B19" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0" />
                            <Border x:Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="10" Background="#D6D4CE" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#5847C9" />
                                <Setter TargetName="Thumb" Property="Margin" Value="18,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 16px 체크박스 (미작성 목록 · 확인 팝업) -->
        <Style x:Key="BoxCheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#5F5D57" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                                        BorderBrush="#B9B6AE" Background="#FFFFFF" VerticalAlignment="Center">
                                    <Viewbox Width="11" Height="11">
                                        <Path x:Name="Mark" Style="{StaticResource IconPath}" Data="{StaticResource IconCheck}"
                                              Stroke="#FFFFFF" StrokeThickness="3" Visibility="Collapsed" />
                                    </Viewbox>
                                </Border>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#8F8C84" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#5847C9" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#5847C9" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1C1B19" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E0DED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#5847C9" />
            <Setter Property="SelectionBrush" Value="#5847C9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Glow" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="#265847C9" Visibility="Hidden" />
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Hidden" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5847C9" />
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordFieldStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1C1B19" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E0DED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#5847C9" />
            <Setter Property="SelectionBrush" Value="#5847C9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="Glow" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="#265847C9" Visibility="Hidden" />
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Hidden" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5847C9" />
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ───────── 버튼 ───────── -->
        <!-- 보조 버튼(흰 바탕 + 테두리). 메일 테스트가 이 스타일만 단독으로 파싱하므로 다른 리소스를 참조하지 않는다. -->
        <Style x:Key="QuietButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1C1B19" />
            <Setter Property="BorderBrush" Value="#E0DED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F7F6F3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFEEEA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 아이콘 + 글자 보조 버튼 (Tag = 아이콘 Geometry) -->
        <Style x:Key="IconTextButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Viewbox Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource IconPath}" StrokeThickness="2"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}" />
                                </Viewbox>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F7F6F3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 목록 행 안의 작은 텍스트 버튼 (삭제). Tag = 아이콘. 마우스를 올리면 빨강 -->
        <Style x:Key="GhostIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#5F5D57" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource IconPath}" StrokeThickness="2"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}" />
                                </Viewbox>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FDECEC" />
                                <Setter Property="Foreground" Value="#B42318" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 배너 안의 흰 버튼 -->
        <Style x:Key="SoftButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#5847C9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FBFAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5847C9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A3AB5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 미작성 목록의 한 행. 흰 바탕, 마우스 오버 시 옅은 회색 -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FAFAF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F4F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 상태 칩 (배경/글자색은 사용처에서 지정) -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 섹션 제목 옆 건수 알약 -->
        <Style x:Key="CountPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#F1F0EC" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 얇은 진행 막대 -->
        <Style x:Key="SlimProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="#5847C9" />
            <Setter Property="Background" Value="#ECEAE4" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>
